/**app.wxss**/
page {
  background-color: #F1F8E9;
  min-height: 100vh;
}

/* 页面容器 */
.container {
  box-sizing: border-box;
  padding: 24rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 主标题 */
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #33691E;
  letter-spacing: 4rpx;
}

/* 副标题 */
.subtitle {
  font-size: 24rpx;
  color: #7A9A5B;
  letter-spacing: 2rpx;
}