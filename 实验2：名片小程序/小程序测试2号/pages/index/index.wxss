page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7f6;
}

.page-scroll {
  flex: 1;
}

.card-page {
  min-height: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.cover {
  position: relative;
  width: 100%;
  height: 390rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #123b51;
  box-shadow: 0 20rpx 52rpx rgba(24, 52, 70, 0.15);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.profile {
  padding: 46rpx 20rpx 24rpx;
  display: flex;
  flex-direction: column;
}

.name {
  color: #183446;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.3;
}

.school {
  margin-top: 14rpx;
  color: #435a66;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.5;
}

.section {
  padding-top: 36rpx;
  border-top: 1rpx solid #d9dfe0;
  margin-top: 36rpx;
}

.section-title {
  display: flex;
  align-items: center;
  color: #183446;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.5;
}

.section-mark {
  width: 7rpx;
  height: 30rpx;
  margin-right: 16rpx;
  background: #41c8cc;
}

.bio {
  display: block;
  margin-top: 20rpx;
  color: #334a57;
  font-size: 33rpx;
  font-weight: 400;
  line-height: 1.9;
}

.blog-button {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 20rpx 26rpx;
  margin-top: 40rpx;
  border-radius: 6rpx;
  background: #183446;
  color: #ffffff;
  text-align: left;
  transition: opacity 160ms ease;
}

.blog-button--pressed {
  opacity: 0.82;
}

.blog-copy {
  display: flex;
  flex-direction: column;
}

.blog-label {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.blog-address {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 1.4;
}

.blog-arrow {
  font-size: 36rpx;
  line-height: 1;
}
