<view class="tab-bar">
  <view class="tab-bar__safe">
    <view
      class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
      hover-class="tab-bar__item--pressed"
    >
      <view class="tab-bar__indicator"></view>
      <image class="tab-bar__icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}"></image>
      <view class="tab-bar__labels">
        <text>{{item.text}}</text>
        <view>{{item.caption}}</view>
      </view>
    </view>
  </view>
</view>
