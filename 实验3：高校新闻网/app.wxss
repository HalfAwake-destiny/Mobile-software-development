page {
  background: #eef2f5;
  color: #132b3d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.news-list {
  background: #ffffff;
}

.news-item {
  display: flex;
  align-items: stretch;
  min-height: 208rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #e2e8ec;
  box-sizing: border-box;
}

.news-item:last-child {
  border-bottom: 0;
}

.news-item__image {
  flex: none;
  width: 232rpx;
  height: 160rpx;
  margin-right: 24rpx;
  border-radius: 4rpx;
  background: #e9edf1;
}

.news-item__body {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 160rpx;
  flex-direction: column;
  justify-content: space-between;
}

.news-item__title {
  display: -webkit-box;
  overflow: hidden;
  color: #132b3d;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-item__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.news-item__category {
  color: #ed3b4f;
  font-size: 21rpx;
  font-weight: 700;
}

.news-item__date,
.news-item__source {
  color: #89959e;
  font-size: 21rpx;
}

.news-item__source {
  display: block;
}

.empty-state {
  padding: 110rpx 32rpx;
  color: #8a949e;
  font-size: 28rpx;
  text-align: center;
}
