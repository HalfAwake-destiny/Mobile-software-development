/* pages/register/register.wxss */
.register-page {
  padding-top: 0;
  margin: -24rpx -28rpx 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4f8 0%, #f5f7fa 30%);
}

/* ===== 顶部 Logo 区 ===== */
.register-hero {
  padding: 96rpx 40rpx 48rpx;
  text-align: center;
}
.register-logo {
  display: inline-flex;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  color: #fff;
  background: linear-gradient(135deg, #237d9c, #45a7c8);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(35, 125, 156, 0.3);
}
.register-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 750;
  color: var(--ha-text);
}
.register-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ha-muted);
}

/* ===== 表单卡片 ===== */
.register-card {
  margin: 0 32rpx;
  padding: 0;
}
.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
}
.field-icon {
  font-size: 32rpx;
  flex: none;
}
.field-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ha-text);
}
.field-placeholder {
  color: #b0b9c4;
}
.field-divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: var(--ha-border);
}

/* ===== 注册按钮 ===== */
.register-btn {
  margin: 48rpx 32rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 650;
  color: #fff;
  background: var(--ha-primary);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(69, 167, 200, 0.35);
}
.register-btn::after {
  border: none;
}
.register-btn[loading]::before {
  margin-right: 8rpx;
}

/* ===== 已有账号 ===== */
.login-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
}
.login-link__hint {
  color: var(--ha-muted);
}
.login-link__action {
  margin-left: 8rpx;
  color: var(--ha-primary-deep);
  font-weight: 600;
}
