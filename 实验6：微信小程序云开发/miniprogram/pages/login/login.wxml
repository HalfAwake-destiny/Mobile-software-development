<!--pages/login/login.wxml-->
<view class="page-bg login-page">
  <!-- 顶部 Logo 区 -->
  <view class="login-hero">
    <view class="login-logo">图</view>
    <view class="login-title">登录图享社区</view>
    <view class="login-sub">分享照片，记录生活</view>
  </view>

  <!-- 表单卡片 -->
  <view class="ha-card login-card">
    <!-- 手机号 -->
    <view class="field">
      <view class="field-icon">📱</view>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="手机号"
        placeholder-class="field-placeholder"
        value="{{phone}}"
        bindinput="onPhoneInput"
      ></input>
    </view>
    <view class="field-divider"></view>

    <!-- 密码 -->
    <view class="field">
      <view class="field-icon">🔒</view>
      <input
        class="field-input"
        type="password"
        maxlength="20"
        placeholder="密码"
        placeholder-class="field-placeholder"
        value="{{password}}"
        bindinput="onPasswordInput"
      ></input>
    </view>
  </view>

  <!-- 登录按钮 -->
  <button class="login-btn" bindtap="onPhoneLogin" loading="{{submitting}}">登录</button>

  <!-- 注册引导 -->
  <view class="register-link">
    <text class="register-link__hint">还没有账号？</text>
    <text class="register-link__action" bindtap="goToRegister">立即注册</text>
  </view>

  <!-- 其他登录方式 -->
  <view class="divider">
    <view class="divider-line"></view>
    <view class="divider-text">其他登录方式</view>
    <view class="divider-line"></view>
  </view>

  <!-- 微信授权登录 -->
  <button class="wechat-btn" bindtap="onWechatLogin">
    <view class="wechat-btn__icon">微</view>
    <text class="wechat-btn__label">微信授权登录</text>
  </button>

  <view class="login-tip">点击即表示同意《用户协议》和《隐私政策》</view>
</view>

<!-- 微信授权的资料弹窗 -->
<view class="editor-mask" wx:if="{{showWechatProfile}}" bindtap="closeWechatProfile"></view>
<view class="profile-editor" wx:if="{{showWechatProfile}}">
  <view class="profile-editor__heading">
    <view>
      <text>设置微信头像昵称</text>
      <view>选择后完成微信授权登录</view>
    </view>
    <button bindtap="closeWechatProfile">×</button>
  </view>

  <view class="avatar-editor">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
      <image wx:if="{{draftAvatarUrl}}" src="{{draftAvatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-picker__empty">+</view>
      <view class="avatar-picker__hint">{{draftAvatarUrl ? '更换头像' : '选择微信头像'}}</view>
    </button>
  </view>

  <view class="name-editor">
    <text>昵称</text>
    <input
      type="nickname"
      maxlength="16"
      value="{{draftNickName}}"
      bindinput="updateDraftName"
      placeholder="请输入昵称"
    ></input>
  </view>

  <button class="profile-save" bindtap="confirmWechatLogin" loading="{{submitting}}">完成登录</button>
</view>
