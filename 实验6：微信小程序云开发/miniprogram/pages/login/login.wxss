/* pages/login/login.wxss */
.login-page {
  padding-top: 0;
  margin: -24rpx -28rpx 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4f8 0%, #f5f7fa 30%);
}

/* ===== 顶部 Logo 区 ===== */
.login-hero {
  padding: 96rpx 40rpx 48rpx;
  text-align: center;
}
.login-logo {
  display: inline-flex;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #237d9c, #45a7c8);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(35, 125, 156, 0.3);
}
.login-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 750;
  color: var(--ha-text);
}
.login-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ha-muted);
}

/* ===== 表单卡片 ===== */
.login-card {
  margin: 0 32rpx;
  padding: 0;
}
.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
}
.field-icon {
  font-size: 32rpx;
  flex: none;
}
.field-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--ha-text);
}
.field-placeholder {
  color: #b0b9c4;
}
.field-divider {
  height: 1rpx;
  margin: 0 28rpx;
  background: var(--ha-border);
}

/* ===== 登录按钮 ===== */
.login-btn {
  margin: 48rpx 32rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 650;
  color: #fff;
  background: var(--ha-primary);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(69, 167, 200, 0.35);
}
.login-btn::after {
  border: none;
}
.login-btn[loading]::before {
  margin-right: 8rpx;
}

/* ===== 注册引导 ===== */
.register-link {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
}
.register-link__hint {
  color: var(--ha-muted);
}
.register-link__action {
  margin-left: 8rpx;
  color: var(--ha-primary-deep);
  font-weight: 600;
}

/* ===== 分隔线 ===== */
.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 64rpx 32rpx 32rpx;
}
.divider-line {
  flex: 1;
  height: 1rpx;
  background: var(--ha-border);
}
.divider-text {
  font-size: 22rpx;
  color: var(--ha-muted);
}

/* ===== 微信授权按钮 ===== */
.wechat-btn {
  display: flex;
  margin: 0 32rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #fff;
  border: 1rpx solid var(--ha-border);
  border-radius: 16rpx;
}
.wechat-btn::after {
  border: none;
}
.wechat-btn__icon {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  background: #07c160;
  border-radius: 50%;
}
.wechat-btn__label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ha-text);
}

/* ===== 协议提示 ===== */
.login-tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ha-muted);
}

/* ===== 资料编辑弹窗（与 homepage 共用样式思路） ===== */
.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 150;
  background: rgba(8, 24, 35, 0.48);
}
.profile-editor {
  position: fixed;
  right: 24rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 160;
  max-height: calc(100vh - 190rpx - env(safe-area-inset-bottom));
  padding: 30rpx;
  overflow-y: auto;
  background: var(--ha-surface);
  border-radius: var(--ha-radius);
  box-shadow: 0 20rpx 60rpx rgba(8, 24, 35, 0.24);
  box-sizing: border-box;
}
.profile-editor__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.profile-editor__heading text {
  color: var(--ha-text);
  font-size: 32rpx;
  font-weight: 700;
}
.profile-editor__heading view view {
  margin-top: 7rpx;
  color: var(--ha-muted);
  font-size: 20rpx;
}
.profile-editor__heading button {
  width: 58rpx;
  height: 58rpx;
  margin: -8rpx -8rpx 0 0;
  padding: 0;
  color: var(--ha-muted);
  font-size: 38rpx;
  font-weight: 300;
  line-height: 58rpx;
  background: transparent;
}
.profile-editor__heading button::after {
  border: 0;
}
.avatar-editor {
  padding: 30rpx 0 22rpx;
  text-align: center;
}
.avatar-picker {
  width: 146rpx;
  margin: 0 auto;
  padding: 0;
  background: transparent;
}
.avatar-picker::after {
  border: 0;
}
.avatar-picker image {
  display: block;
  width: 126rpx;
  height: 126rpx;
  margin: 0 auto;
  border: 5rpx solid #e8f4f8;
  border-radius: 50%;
  box-sizing: border-box;
}
.avatar-picker__hint {
  margin-top: 12rpx;
  color: var(--ha-primary-deep);
  font-size: 22rpx;
  line-height: 1.2;
}
.avatar-picker .avatar-picker__empty {
  display: flex;
  width: 126rpx;
  height: 126rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  color: var(--ha-primary);
  font-size: 54rpx;
  font-weight: 300;
  line-height: 1;
  background: #edf6fa;
  border: 3rpx dashed rgba(69, 167, 200, 0.5);
  border-radius: 50%;
  box-sizing: border-box;
}
.name-editor {
  display: flex;
  height: 90rpx;
  padding: 0 20rpx;
  align-items: center;
  background: #f4f7f8;
  border: 1rpx solid var(--ha-border);
  border-radius: var(--ha-radius-small);
  box-sizing: border-box;
}
.name-editor > text {
  flex: none;
  margin-right: 22rpx;
  color: var(--ha-text);
  font-size: 24rpx;
}
.name-editor input {
  flex: 1;
  min-width: 0;
  color: var(--ha-text);
  font-size: 27rpx;
}
.profile-save {
  height: 78rpx;
  margin: 26rpx 0 0;
  color: #fff;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 78rpx;
  background: var(--ha-primary);
  border-radius: var(--ha-radius-small);
}
.profile-save::after {
  border: 0;
}
