/* pages/detail/detail.wxss */
.detail-page { padding-top: 16rpx; }

.detail-photo-wrap {
  padding: 0;
  margin-bottom: 24rpx;
  background: #f0f3f7;
}
.detail-photo {
  display: block;
  width: 100%;
  background: #f0f3f7;
}

.uploader {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}
.uploader-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(69, 167, 200, 0.12);
  flex: 0 0 auto;
}
.uploader-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.uploader-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ha-text);
}
.uploader-loc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ha-muted);
}
.uploader-date {
  font-size: 24rpx;
  color: var(--ha-muted);
  flex: 0 0 auto;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 8rpx 0 40rpx;
}
.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
}

/* 收藏按钮：未收藏白底橙字，已收藏橙底白字 */
.fav-btn {
  color: #e8890c;
  background: #fff;
  border: 1rpx solid rgba(255, 166, 88, 0.55);
}
.fav-btn--on {
  color: #fff;
  background: linear-gradient(135deg, #f5a623, #e8890c);
  border: 1rpx solid transparent;
}

/* 删除按钮：白底红字红边，与青色系操作区分 */
.delete-btn {
  color: #e6604c;
  background: #fff;
  border: 1rpx solid rgba(230, 96, 76, 0.45);
}
.delete-btn:active {
  background: rgba(230, 96, 76, 0.08);
}
