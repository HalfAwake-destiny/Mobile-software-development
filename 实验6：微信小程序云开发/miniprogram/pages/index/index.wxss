/* pages/index/index.wxss */
.index-page { padding-top: 16rpx; }

.welcome-bar {
  padding: 8rpx 4rpx 28rpx;
}
.welcome-title {
  font-size: 44rpx;
  font-weight: 750;
  color: var(--ha-text);
  letter-spacing: 0.5rpx;
}
.welcome-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ha-muted);
}

/* 浮动按钮组：固定在右上，同一行排列，「我的」在左、「上传」在右 */
.fab-group {
  position: fixed;
  top: 80rpx;
  right: 32rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.fab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 26rpx;
  background: var(--ha-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(69, 167, 200, 0.35);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.fab-hover {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(69, 167, 200, 0.3);
}
.fab-plus {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
  margin-right: 2rpx;
}
.fab-label { line-height: 1; }

/* 同组内不再各自定位，由 .fab-group 统一排版 */
.fab-upload {
  background: var(--ha-primary);
}
.fab-mine {
  background: var(--ha-surface);
  color: var(--ha-text);
  border: 1rpx solid var(--ha-border);
  box-shadow: 0 10rpx 24rpx rgba(25, 35, 50, 0.12);
  max-width: 220rpx;
}
.fab-mine .fab-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fab-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex: none;
}
.fab-mine-icon {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(69, 167, 200, 0.12);
  color: var(--ha-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  flex: none;
}
