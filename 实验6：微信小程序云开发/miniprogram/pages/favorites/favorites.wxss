/* pages/favorites/favorites.wxss */
.fav-page { padding-top: 16rpx; }

.fav-header { padding: 8rpx 4rpx 28rpx; }
.fav-title {
  font-size: 44rpx;
  font-weight: 750;
  color: var(--ha-text);
  letter-spacing: 0.5rpx;
}
.fav-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ha-muted);
}

.fav-card { margin-bottom: 28rpx; }
.fav-img {
  display: block;
  width: 100%;
  background: #f0f3f7;
}
.fav-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 28rpx;
  border-top: 1rpx solid var(--ha-border);
  background: #f8fafc;
}
.fav-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.fav-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ha-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fav-date {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ha-muted);
}
.fav-remove {
  flex: none;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #e6604c;
  background: #fff;
  border: 1rpx solid rgba(230, 96, 76, 0.45);
  border-radius: 999rpx;
}
.fav-remove--hover { background: rgba(230, 96, 76, 0.08); }

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ha-muted);
}
.empty-btn {
  margin-top: 32rpx;
}
