/* components/photo-card/photo-card.wxss */
.photo-card {
  margin-bottom: 28rpx;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.ha-card-hover {
  transform: translateY(-2rpx);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 166, 88, 0.32),
    inset 0 0 30rpx 8rpx rgba(255, 166, 88, 0.24),
    0 10rpx 32rpx rgba(255, 140, 60, 0.18);
}

.photo-card-head {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  gap: 20rpx;
}
.head-avatar-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(69, 167, 200, 0.12);
  flex: 0 0 auto;
}
.head-avatar-hover { opacity: 0.75; }
.head-avatar { width: 100%; height: 100%; display: block; }
.head-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.head-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ha-text);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.head-loc {
  font-size: 24rpx;
  color: var(--ha-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-card-body {
  background: #f0f3f7;
  position: relative;
}
.photo-card-body-hover { opacity: 0.92; }
.photo-img {
  display: block;
  width: 100%;
  background: #f0f3f7;
}
.photo-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  color: var(--ha-muted);
  font-size: 24rpx;
}

.photo-card-foot {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 28rpx;
  border-top: 1rpx solid var(--ha-border);
  /* 底部一条浅色背景，跟卡身白色区分开 */
  background: #f8fafc;
}
.foot-date {
  font-size: 24rpx;
  color: var(--ha-muted);
  letter-spacing: 0.5rpx;
}
